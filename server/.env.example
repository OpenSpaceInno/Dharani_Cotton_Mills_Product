# ==============================================================================
# Backend Server Environment Template (server/.env.example)
# ==============================================================================

NODE_ENV=development
PORT=3001
CORS_ORIGIN=*

# Local MySQL Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CHANGE_ME
DB_NAME=dharani_weighbridge
DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT_MS=10000

# Background Sync Configuration
PLANT_ID=PL01
CLOUD_SYNC_ENABLED=true
CLOUD_SYNC_INTERVAL_MS=300000
CLOUD_SYNC_BATCH_SIZE=200
SYNC_RUN_SCHEDULER=true
SYNC_DELETE_PROPAGATION=true
SYNC_USERS_ENABLED=false

# Remote Production Server MySQL
REMOTE_DB_HOST=YOUR_SERVER_IP
REMOTE_DB_PORT=3306
REMOTE_DB_USER=CHANGE_ME
REMOTE_DB_PASSWORD=CHANGE_ME
REMOTE_DB_NAME=dharani_weighbridge

# Secondary HTTP Fallback
CLOUD_SERVER_URL=http://YOUR_SERVER_IP:3001
CLOUD_SYNC_SECRET=CHANGE_ME

# ANPR FTP Watcher
FTP_ENABLED=true
FTP_HOST=ftp.example.com
FTP_PORT=2121
FTP_USER=CHANGE_ME
FTP_PASSWORD=CHANGE_ME
FTP_DIR=/Dharani
