# ==============================================================================
# Dharani Weighbridge & Gate Management System - Environment Template
# Copy to .env.development (local) or .env.production (server) and fill secrets.
# NEVER commit real passwords or secrets to version control.
# ==============================================================================

# Application Mode
NODE_ENV=development
PORT=3001
CORS_ORIGIN=*

# Frontend API Endpoint
VITE_API_URL=http://localhost:3001/api
VITE_PORT=8080

# Primary Application MySQL Database
# Local development: localhost:3306 | Production Docker: database:3306 (or managed host)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_NAME=dharani_weighbridge
DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT_MS=10000
DB_ACQUIRE_TIMEOUT_MS=10000

# Docker / Host Port Bindings
FRONTEND_PORT=8080
BACKEND_PORT=3001
PMA_PORT=8081

# phpMyAdmin Configuration
# Set PMA_HOST to 'database' (Docker MySQL) or external production MySQL IP/host
PMA_HOST=database
PMA_PORT_NUM=3306
PMA_ABSOLUTE_URI=
PMA_BASIC_AUTH_USER=admin
PMA_BASIC_AUTH_PASS=CHANGE_ME_PMA_GUARD

# Plant / Terminal Identity
PLANT_ID=PL01

# Background Local -> Server MySQL Synchronization (5-Minute Schedule)
CLOUD_SYNC_ENABLED=true
CLOUD_SYNC_INTERVAL_MS=300000
CLOUD_SYNC_BATCH_SIZE=200
SYNC_RUN_SCHEDULER=true
SYNC_DELETE_PROPAGATION=true
SYNC_USERS_ENABLED=false

# Source MySQL for Dedicated Sync Worker (defaults to DB_* if unset)
SOURCE_DB_HOST=localhost
SOURCE_DB_PORT=3306
SOURCE_DB_USER=root
SOURCE_DB_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD
SOURCE_DB_NAME=dharani_weighbridge

# Destination Production Server MySQL (for Sync Service)
REMOTE_DB_HOST=YOUR_SERVER_IP_OR_HOST
REMOTE_DB_PORT=3306
REMOTE_DB_USER=CHANGE_ME_REMOTE_DB_USER
REMOTE_DB_PASSWORD=CHANGE_ME_REMOTE_DB_PASSWORD
REMOTE_DB_NAME=dharani_weighbridge
REMOTE_DB_POOL_SIZE=4
REMOTE_DB_CONNECT_TIMEOUT_MS=8000

# Secondary HTTP Sync Fallback (Optional)
CLOUD_SERVER_URL=http://YOUR_SERVER_IP_OR_HOST:3001
CLOUD_SYNC_SECRET=CHANGE_ME_SHARED_SYNC_SECRET

# ANPR / FTP Camera Storage (Optional)
FTP_ENABLED=true
FTP_HOST=ftp.example.com
FTP_PORT=2121
FTP_USER=CHANGE_ME_FTP_USER
FTP_PASSWORD=CHANGE_ME_FTP_PASSWORD
FTP_DIR=/Dharani
FTP_CAMERA_HOST=ftp.example.com
FTP_CAMERA_PORT=2121
FTP_CAMERA_USER=CHANGE_ME_CAMERA_USER
FTP_CAMERA_PASSWORD=CHANGE_ME_CAMERA_PASSWORD
