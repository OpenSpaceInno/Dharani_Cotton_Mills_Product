{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",

  "appId"       : "com.dharani.weighbridge",
  "productName" : "Dharani Weighbridge",
  "copyright"   : "Copyright © 2026 Dharani Cotton Mills",

  "directories": {
    "output"       : "release",
    "buildResources": "build-assets"
  },

  "compression" : "maximum",
  "removePackageScripts": true,

  "electronLanguages": ["en-US"],

  "asar": true,
  "asarUnpack": [
    "**/node_modules/@serialport/**",
    "**/node_modules/serialport/**",
    "**/node_modules/bindings/**",
    "**/node_modules/node-gyp-build/**",
    "server/**"
  ],

  "files": [
    "dist/**/*",
    "electron/**/*",
    "server/index.js",
    "server/db.js",
    "server/anpr-processor.js",
    "server/ftp-anpr-watcher.js",
    "server/cloud-sync-service.js",
    "server/sync-worker.js",
    "server/init.sql",
    "server/config/**/*",
    "server/routes/**/*",
    "server/package.json",
    "server/node_modules/**/*",
    "!node_modules/**/*",
    "!src/**/*",
    "!scripts/**/*",
    "!docker/**/*",
    "!docs/**/*",
    "!data/**/*",
    "!logs/**/*",
    "!release/**/*",
    "!electron-downloads/**/*",
    "!build-assets/**/*",
    "!**/*.md",
    "!**/*.map",
    "!**/*.ts",
    "!**/*.tsx",
    "!**/*.log",
    "!**/.git/**/*",
    "!**/.env",
    "!**/.env.*",
    "!**/mediamtx.log",
    "!server/migrations/**/*",
    "!server/temp_sync/**/*",
    "!server/tests/**/*",
    "!server/scripts/**/*",
    "!server/.env",
    "!server/.env.*",
    "!server/node_modules/**/test/**",
    "!server/node_modules/**/tests/**",
    "!server/node_modules/**/docs/**",
    "!server/node_modules/**/doc/**",
    "!server/node_modules/**/example/**",
    "!server/node_modules/**/examples/**",
    "!server/node_modules/**/.bin/**",
    "!server/node_modules/**/README*",
    "!server/node_modules/**/CHANGELOG*",
    "!server/node_modules/**/LICENCE*",
    "!server/node_modules/**/LICENSE*",
    "!server/node_modules/**/*.md"
  ],

  "extraResources": [
    {
      "from"  : "build-assets/icons",
      "to"    : "icons",
      "filter": ["**/*"]
    },
    {
      "from": "mediamtx.exe",
      "to": "mediamtx.exe"
    },
    {
      "from": "mediamtx.yml",
      "to": "mediamtx.yml"
    }
  ],

  "win": {
    "icon"                   : "build-assets/icons/icon.ico",
    "target"                 : [
      {
        "target": "nsis",
        "arch"  : ["x64"]
      }
    ],
    "requestedExecutionLevel": "asInvoker",
    "artifactName"           : "Dharani-Weighbridge-Setup-${version}-x64.exe"
  },

  "nsis": {
    "oneClick"              : false,
    "allowToChangeInstallationDirectory": true,
    "allowElevation"        : true,
    "createDesktopShortcut" : true,
    "createStartMenuShortcut": true,
    "shortcutName"          : "Dharani Weighbridge",
    "installerIcon"         : "build-assets/icons/icon.ico",
    "uninstallerIcon"       : "build-assets/icons/icon.ico",
    "installerHeaderIcon"   : "build-assets/icons/icon.ico",
    "deleteAppDataOnUninstall": false,
    "runAfterFinish"        : true,
    "menuCategory"          : "Dharani Cotton Mills",
    "license"               : "build-assets/license.txt",
    "include"               : "build-assets/installer.nsh"
  },

  "publish": null
}
